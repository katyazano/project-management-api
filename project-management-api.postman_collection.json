{
  "info": {
    "name": "Project Management API",
    "description": "Collection covering auth, projects, documents, and access endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000", "type": "string" },
    { "key": "access_token", "value": "", "type": "string" },
    { "key": "project_id", "value": "1", "type": "string" },
    { "key": "document_id", "value": "1", "type": "string" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{access_token}}", "type": "string" }
    ]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin_test\",\n  \"email\": \"admin@example.com\",\n  \"password\": \"SecurePass1!\",\n  \"repeat_password\": \"SecurePass1!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth",
              "host": ["{{base_url}}"],
              "path": ["auth"]
            }
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const data = pm.response.json();",
                  "    pm.collectionVariables.set('access_token', data.access_token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "username", "value": "admin_test", "type": "text" },
                { "key": "password", "value": "SecurePass1!", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{base_url}}/login",
              "host": ["{{base_url}}"],
              "path": ["login"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Projects",
      "item": [
        {
          "name": "Create Project",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const data = pm.response.json();",
                  "    pm.collectionVariables.set('project_id', data.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Project Test\",\n  \"description\": \"Created via Postman\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/projects",
              "host": ["{{base_url}}"],
              "path": ["projects"]
            }
          },
          "response": []
        },
        {
          "name": "Get All Projects",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/projects",
              "host": ["{{base_url}}"],
              "path": ["projects"]
            }
          },
          "response": []
        },
        {
          "name": "Get Project Info",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/project/{{project_id}}/info",
              "host": ["{{base_url}}"],
              "path": ["project", "{{project_id}}", "info"]
            }
          },
          "response": []
        },
        {
          "name": "Update Project Info",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Project Test Updated\",\n  \"description\": \"Updated via Postman\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/project/{{project_id}}/info",
              "host": ["{{base_url}}"],
              "path": ["project", "{{project_id}}", "info"]
            }
          },
          "response": []
        },
        {
          "name": "Delete Project",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{base_url}}/project/{{project_id}}",
              "host": ["{{base_url}}"],
              "path": ["project", "{{project_id}}"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Documents",
      "item": [
        {
          "name": "Get Project Documents",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/project/{{project_id}}/documents",
              "host": ["{{base_url}}"],
              "path": ["project", "{{project_id}}", "documents"]
            }
          },
          "response": []
        },
        {
          "name": "Upload Document",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const data = pm.response.json();",
                  "    if (Array.isArray(data) && data.length > 0) {",
                  "        pm.collectionVariables.set('document_id', data[0].id);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "files", "type": "file", "src": [] }
              ]
            },
            "url": {
              "raw": "{{base_url}}/project/{{project_id}}/documents",
              "host": ["{{base_url}}"],
              "path": ["project", "{{project_id}}", "documents"]
            }
          },
          "response": []
        },
        {
          "name": "Download Document",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/document/{{document_id}}",
              "host": ["{{base_url}}"],
              "path": ["document", "{{document_id}}"]
            }
          },
          "response": []
        },
        {
          "name": "Update Document",
          "request": {
            "method": "PUT",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": [] }
              ]
            },
            "url": {
              "raw": "{{base_url}}/document/{{document_id}}",
              "host": ["{{base_url}}"],
              "path": ["document", "{{document_id}}"]
            }
          },
          "response": []
        },
        {
          "name": "Delete Document",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{base_url}}/document/{{document_id}}",
              "host": ["{{base_url}}"],
              "path": ["document", "{{document_id}}"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Access",
      "item": [
        {
          "name": "Invite / Update Member Role",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/project/{{project_id}}/invite?user=someuser&role=editor",
              "host": ["{{base_url}}"],
              "path": ["project", "{{project_id}}", "invite"],
              "query": [
                { "key": "user", "value": "someuser" },
                { "key": "role", "value": "editor" }
              ]
            }
          },
          "response": []
        }
      ]
    }
  ]
}
